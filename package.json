{
  "name": "@cdcp-rcsd/workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "run-s --continue-on-error -l format:check typecheck lint check:workspaces",
    "check:workspaces": "pnpm -r --no-bail run check",
    "format:check": "oxfmt --check",
    "format:write": "oxfmt --write",
    "lint": "oxlint --config ./oxlint.config.ts",
    "lint:fix": "oxlint --config ./oxlint.config.ts --fix",
    "test": "vitest run",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:ui": "vitest --ui --coverage.enabled=true",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=26.12.1 <27.0.0",
    "pnpm": ">=12.15.0 <13.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
