{
  "name": "@cdcp-rcsd/workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "run-s --continue-on-error -l format:check typecheck lint check:workspaces",
    "check:workspaces": "pnpm -r --no-bail run check",
    "format:check": "oxfmt --check",
    "format:write": "oxfmt --write",
    "lint": "oxlint --config ./oxlint.config.ts",
    "lint:fix": "oxlint --config ./oxlint.config.ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "catalog:",
    "@types/node": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=26.10.0 <27.0.0",
    "pnpm": ">=12.0.0 <13.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
