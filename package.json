{
  "name": "@cdcp-rcsd/workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "check:workspaces": "pnpm -r --no-bail run check",
    "check": "run-s --continue-on-error -l format:check check:workspaces"
  },
  "devDependencies": {
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:"
  },
  "engines": {
    "node": ">=26.10.0 <27.0.0",
    "pnpm": ">=12.0.0 <13.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
