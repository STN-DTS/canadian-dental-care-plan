{
  "name": "@cdcp-rcsd/workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @cdcp-rcsd/frontend run dev",
    "dbg": "pnpm --filter @cdcp-rcsd/frontend run dbg",
    "build": "pnpm --filter @cdcp-rcsd/frontend run build",
    "test": "pnpm --filter @cdcp-rcsd/frontend run test",
    "test:unit": "pnpm --filter @cdcp-rcsd/frontend run test:unit",
    "test:unit:coverage": "pnpm --filter @cdcp-rcsd/frontend run test:unit:coverage",
    "test:e2e": "pnpm --filter @cdcp-rcsd/frontend run test:e2e",
    "test:e2e:smoke": "pnpm --filter @cdcp-rcsd/frontend run test:e2e:smoke",
    "test:e2e:install": "pnpm --filter @cdcp-rcsd/frontend run test:e2e:install",
    "typecheck": "pnpm --filter @cdcp-rcsd/frontend run typecheck",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "pnpm run format:check && pnpm run typecheck && pnpm --filter @cdcp-rcsd/frontend run lint:oxlint",
    "lint:fix": "pnpm run format:fix && pnpm --filter @cdcp-rcsd/frontend run lint:oxlint:fix"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0",
    "pnpm": ">=12.0.0 <13.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}
