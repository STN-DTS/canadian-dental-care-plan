{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "customManagers:githubActionsVersions", ":semanticCommits", ":automergeAll"],
  "labels": ["renovate"],
  "minimumReleaseAge": "3 days",
  // Production image promotion is reviewed separately from Renovate updates.
  "ignorePaths": ["gitops/prod/**"],
  "kubernetes": {
    "managerFilePatterns": ["/^gitops\\/nonprod\\/.+\\.ya?ml$/"]
  },
  "automergeStrategy": "squash",
  // ------------------------------------
  // temporary test configuration
  "automerge": false,
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  // ------------------------------------
  "postUpgradeTasks": {
    "commands": ["pnpm install --recursive --include-workspace-root --frozen-lockfile --ignore-scripts", "pnpm format:write"],
    "executionMode": "branch",
    "fileFilters": ["**/*"],
    "installTools": {
      "node": {},
      "pnpm": {}
    }
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["security"]
  },
  "packageRules": [
    {
      // Aqua's IP allowlist rejects App-authenticated API lookups; public Git tags retain SHA pinning.
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["aquasecurity/trivy-action"],
      "overrideDatasource": "git-tags",
      "overridePackageName": "https://github.com/aquasecurity/trivy-action.git",
      // Git tag lookup has no publication timestamps.
      "minimumReleaseAge": null
    },
    {
      // Application builds and environment promotion manage this private registry, not Renovate.
      "matchDatasources": ["docker"],
      "matchPackageNames": ["dtsrhpdevscedacr.azurecr.io/**"],
      "enabled": false
    },
    {
      "matchFileNames": ["gitops/**"],
      "automerge": false,
      // Keep deployment changes out of cross-file dependency groups.
      "groupName": null
    },
    {
      // Limit frequent runtime releases and existing PR refreshes to the weekly window.
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["renovatebot/renovate"],
      "extends": ["schedule:weekly"],
      "updateNotScheduled": false
    },
    {
      // GCR does not expose image release timestamps for Renovate's minimumReleaseAge check.
      "matchDatasources": ["docker"],
      "matchPackageNames": ["gcr.io/distroless/nodejs26-debian13"],
      "matchUpdateTypes": ["digest"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ]
}
