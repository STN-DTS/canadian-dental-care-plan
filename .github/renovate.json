{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "customManagers:githubActionsVersions", ":semanticCommits", ":automergeAll"],
  "labels": ["renovate"],
  "minimumReleaseAge": "3 days",
  "automergeStrategy": "squash",
  "postUpgradeTasks": {
    "commands": ["pnpm install --recursive --include-workspace-root --frozen-lockfile --ignore-scripts", "pnpm format:write"],
    "executionMode": "branch",
    "fileFilters": ["**/*"],
    "installTools": {
      "node": {},
      "pnpm": {}
    }
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["security"]
  },
  "packageRules": [
    {
      // Limit frequent runtime releases and existing PR refreshes to the weekly window.
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["renovatebot/renovate"],
      "extends": ["schedule:weekly"],
      "updateNotScheduled": false
    },
    {
      // GCR does not expose image release timestamps for Renovate's minimumReleaseAge check.
      "matchDatasources": ["docker"],
      "matchPackageNames": ["gcr.io/distroless/nodejs26-debian13"],
      "matchUpdateTypes": ["digest"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ]
}
