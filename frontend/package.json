    "i18next-cli": "^1.74.1",
    "jsdom": "30.1.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "playwright-teamcity-reporter": "^1.0.5",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "type-fest": "^5.10.0",
