    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.11.0",
    "i18next-cli": "^1.71.3",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "playwright-teamcity-reporter": "^1.0.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.12",
