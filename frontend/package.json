{
  "name": "@cdcp-rcsd/frontend",
  "private": true,
  "files": [
    "build",
    "public"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run build:application && pnpm run build:server",
    "build:application": "react-router build",
    "build:server": "vite build --config ./vite.server.config.ts",
    "dbg": "cross-env NODE_ENV=development tsx --conditions development --inspect --env-file-if-exists=./.env --experimental-loader=@opentelemetry/instrumentation/hook.mjs --import ./app/.server/express-server/opentelemetry.ts ./app/.server/express-server/server.ts",
    "dev": "cross-env NODE_ENV=development tsx --conditions development --env-file-if-exists=./.env --experimental-loader=@opentelemetry/instrumentation/hook.mjs --import ./app/.server/express-server/opentelemetry.ts ./app/.server/express-server/server.ts",
    "preview": "pnpm run build && cross-env NODE_ENV=production SESSION_COOKIE_SECURE=false node --env-file-if-exists=./.env --experimental-loader=@opentelemetry/instrumentation/hook.mjs --import ./build/server/opentelemetry.js ./build/server/server.js",
    "start": "cross-env NODE_ENV=production node --experimental-loader=@opentelemetry/instrumentation/hook.mjs --import ./build/server/opentelemetry.js ./build/server/server.js",
    "check": "run-s --continue-on-error -l typecheck lint",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "react-router typegen && tsc",
    "test:e2e": "playwright test",
    "test:e2e:ci": "cross-env CI=true pnpm run test:e2e",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test": "vitest run",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:ui": "vitest --ui --coverage.enabled=true"
  },
