# syntax=docker/dockerfile:1.28.0@sha256:bb22d9815c728170f72750f4e5b0d672e06176142e1d602c7e66c050100b7e5b

# Dockerfile to build the Canadian Dental Care Plan frontend.
# Directive order is optimized for Docker layer caching.
#
# The following arguments should be set at build time, although sane defaults
# are provided:
#
#     - BUILD_DATE
#     - BUILD_ID
#     - BUILD_REVISION
#     - BUILD_VERSION
#
# Example:
#
#   docker build --file frontend/dockerfile . \
#     --tag canadian-dental-care-plan \
#     --build-arg BUILD_DATE="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
#     --build-arg BUILD_ID="0001" \
#     --build-arg BUILD_REVISION="$(git rev-parse --short=8 HEAD)" \
#     --build-arg BUILD_VERSION="1.0.0"
#
#   docker inspect canadian-dental-care-plan
#
#   docker run --init --interactive --tty --rm \
#     --publish 3000:3000 \
#     --env-file frontend/.env \
#     --name canadian-dental-care-plan \
#     canadian-dental-care-plan


# ---------------------------------------------------------------------------- #
# Stage: Build
# Install dependencies, compile the application, and package production output.
# ---------------------------------------------------------------------------- #

FROM docker.io/library/node:26.12.0-trixie-slim@sha256:e556a144463cc8dc53afe8de6d2fa0db5c132fd39ffa232c17641bd40df2bf11 AS build

WORKDIR /home/node

# Install the pnpm version declared by package.json.
COPY --chown=node:node package.json ./

RUN npm install --global "$(node -p 'require("./package.json").packageManager')" \
    && pnpm --version

USER node

# USER does not set COPY ownership; --chown keeps workspace files writable by node.
# Copy only dependency inputs here so source changes can reuse the install layer.
COPY --chown=node:node pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --chown=node:node frontend/package.json ./frontend/
COPY --chown=node:node patches/ ./patches/

# Install the complete dependency set, including development dependencies
# required to build the application.
RUN pnpm install --frozen-lockfile

# Copy source and build configuration after installation to preserve its cache.
COPY --chown=node:node frontend/app/ ./frontend/app/
COPY --chown=node:node frontend/public/ ./frontend/public/
COPY --chown=node:node frontend/react-router.config.ts ./frontend/
COPY --chown=node:node frontend/tsconfig.json ./frontend/
COPY --chown=node:node frontend/vite.config.ts ./frontend/
COPY --chown=node:node frontend/vite.server.config.ts ./frontend/

RUN pnpm --filter @cdcp-rcsd/frontend run build

# Package the frontend with an isolated production dependency tree.
RUN pnpm --filter @cdcp-rcsd/frontend --prod deploy /home/node/deploy


# ---------------------------------------------------------------------------- #
# Stage: Final Production Image
# Use distroless to keep package managers and build tools out of the runtime,
# reducing image size and attack surface compared with the build image.
# Include production dependencies, runtime metadata, public assets, and compiled
# application code.
#
# Choose the debug tag to retain a BusyBox shell for troubleshooting:
# docker exec -it <container> /busybox/sh
# podman exec -it <container> /busybox/sh
# ---------------------------------------------------------------------------- #

FROM gcr.io/distroless/nodejs26-debian13:debug@sha256:af7c073f55652b5b6cf653b8da72dcbcecc31d7df8f9776801ca91fb595ef6d6

ARG BUILD_DATE="1970-01-01T00:00:00.000Z"
ARG BUILD_ID="000000"
ARG BUILD_REVISION="00000000"
ARG BUILD_VERSION="0.0.0"
ARG IMAGE_AUTHORS="Digital Technology Solutions"
ARG IMAGE_DESCRIPTION="Canadian Dental Care Plan -- Frontend Application"
ARG IMAGE_TITLE="Canadian Dental Care Plan"
ARG IMAGE_URL="https://github.com/STN-DTS/canadian-dental-care-plan/"
ARG IMAGE_VENDOR="Employment and Social Development Canada"

ENV BUILD_DATE="${BUILD_DATE}" \
    BUILD_ID="${BUILD_ID}" \
    BUILD_REVISION="${BUILD_REVISION}" \
    BUILD_VERSION="${BUILD_VERSION}" \
    OTEL_SERVICE_VERSION="${BUILD_VERSION}" \
    NODE_ENV="production" \
    PORT="3000"

# OCI image metadata:
# https://github.com/opencontainers/image-spec/blob/main/annotations.md
LABEL org.opencontainers.image.authors="${IMAGE_AUTHORS}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.description="${IMAGE_DESCRIPTION}" \
      org.opencontainers.image.revision="${BUILD_REVISION}" \
      org.opencontainers.image.title="${IMAGE_TITLE}" \
      org.opencontainers.image.url="${IMAGE_URL}" \
      org.opencontainers.image.vendor="${IMAGE_VENDOR}" \
      org.opencontainers.image.version="${BUILD_VERSION}"

# The server build preserves bare package imports, so production node_modules
# must be included. package.json is retained for Node package settings such as
# "type": "module".
COPY --from=build --chown=nonroot:nonroot /home/node/deploy/ /app/

WORKDIR /app

USER nonroot:nonroot

CMD ["--import", "./build/server/opentelemetry-register.js", "--import", "./build/server/opentelemetry.js", "./build/server/server.js"]